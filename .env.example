# ===========================================================================
# SIH 2026 - POLICE AI INVESTIGATION PLATFORM (.env.example)
# ===========================================================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# PostgreSQL Database Connection
DATABASE_URL=postgres://postgres:password123@localhost:5432/sih2026

# S3 / MinIO Object Storage (Evidence Files)
S3_BUCKET_NAME=police-evidence
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Hugging Face AI Model Hub Space
HF_SPACE_URL=https://your-username-your-space.hf.space
GNN_SERVICE_URL=https://your-username-your-space.hf.space
POLICE_AI_BASE_URL=https://your-username-your-space.hf.space

# Background Automation Cron
ENABLE_DOCUMENT_PROCESSOR_CRON=true
DOCUMENT_CRON_INTERVAL_SECS=30
GNN_AUTO_TRIGGER=true

# Optional: NVIDIA NIM API
# NVIDIA_API_KEY=
# NVIDIA_MODEL=moonshotai/moonlight-16b-a3b-instruct
# NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
